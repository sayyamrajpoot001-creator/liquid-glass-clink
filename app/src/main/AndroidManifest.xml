<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.clink.keyboard">
<application android:label="Clink Glass" android:theme="@android:style/Theme.NoTitleBar">
<activity android:name=".MainActivity" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
<service android:name=".ClinkInputMethodService" android:permission="android.permission.BIND_INPUT_METHOD" android:exported="true"><intent-filter><action android:name="android.view.InputMethod"/></intent-filter><meta-data android:name="android.view.im" android:resource="@xml/method"/></service>
</application>
</manifest>